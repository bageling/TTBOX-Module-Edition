[Unit]
Description=TTBOX USB mouse passthrough proxy (YU-compatible)
After=multi-user.target aiassistance-daemon.service usb-proxy.service
Conflicts=usb-proxy.service usb-proxy-test.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/opt/ttbox/usbproxy
Environment=USB_PROXY_DEVICE=fc000000.usb
Environment=USB_PROXY_DRIVER=dwc3-gadget
Environment=USB_PROXY_MODE=full
Environment=USB_PROXY_SOCKET_DIR=/run/ttbox-mouse-passthrough
RuntimeDirectory=ttbox-mouse-passthrough
RuntimeDirectoryMode=0755
ExecStartPre=-/usr/bin/systemctl stop usb-proxy.service usb-proxy-test.service mouse-passthrough.service opi-mouse-gadget.service usbdevice.service
ExecStartPre=/usr/sbin/modprobe raw_gadget
ExecStart=/opt/ttbox/usbproxy/board/run-ttbox-usb-proxy.sh
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5
SendSIGKILL=yes

[Install]
WantedBy=multi-user.target
